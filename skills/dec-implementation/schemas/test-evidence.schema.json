{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["version", "designDigestAlgorithm", "designDigest", "bindingDigest", "sourceDigest", "additionalInputs", "exitCode", "command", "startedAt", "finishedAt", "reports"],
  "additionalProperties": false,
  "properties": {
    "version": {"const": "dec-binding-evidence/v1"},
    "designDigestAlgorithm": {"const": "dec-yaml-json-sha256/v1"},
    "designDigest": {"$ref": "#/$defs/digest"},
    "bindingDigest": {"$ref": "#/$defs/digest"},
    "sourceDigest": {"$ref": "#/$defs/digest"},
    "additionalInputs": {"type": "array", "items": {
      "type": "object", "required": ["path", "digest"], "additionalProperties": false,
      "properties": {"path": {"type": "string", "minLength": 1}, "digest": {"$ref": "#/$defs/digest"}}
    }},
    "exitCode": {"const": 0},
    "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "startedAt": {"type": "string", "minLength": 1},
    "finishedAt": {"type": "string", "minLength": 1},
    "reports": {"type": "array", "minItems": 1, "items": {
      "type": "object", "required": ["file", "digest"], "additionalProperties": false,
      "properties": {"file": {"type": "string", "minLength": 1}, "digest": {"$ref": "#/$defs/digest"}}
    }}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
