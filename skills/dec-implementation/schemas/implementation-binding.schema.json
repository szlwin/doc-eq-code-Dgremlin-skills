{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/dec/implementation-binding.schema.json",
  "type": "object",
  "required": ["version", "bindings"],
  "properties": {
    "version": {"const": "dec-binding/v1"},
    "bindings": {
      "type": "array",
      "items": {"$ref": "#/$defs/binding"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "location": {
      "type": "object",
      "properties": {
        "module": {"type": "string", "minLength": 1},
        "file": {"type": "string", "minLength": 1},
        "class": {"type": "string", "minLength": 1},
        "method": {"type": "string", "minLength": 1},
        "symbol": {"type": "string", "minLength": 1},
        "notes": {"type": "string"}
      },
      "additionalProperties": false,
      "anyOf": [
        {"required": ["file"]},
        {"required": ["symbol"]},
        {"required": ["class"]}
      ]
    },
    "binding": {
      "type": "object",
      "required": ["designId", "strategy", "status"],
      "properties": {
        "designId": {"type": "string", "minLength": 1},
        "strategy": {"enum": ["REUSE", "COMPATIBLE_EXTEND", "MODIFY", "CREATE"]},
        "status": {"enum": ["PLANNED", "IMPLEMENTED", "VERIFIED", "BLOCKED", "REMOVED"]},
        "runtimeManaged": {"type": "boolean"},
        "runtimeCapability": {"type": "string"},
        "implementation": {"type": "array", "items": {"$ref": "#/$defs/location"}},
        "tests": {"type": "array", "items": {"$ref": "#/$defs/location"}},
        "notes": {"type": "string"}
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"runtimeManaged": {"const": true}}, "required": ["runtimeManaged"]},
          "then": {"required": ["runtimeCapability"]}
        }
      ]
    }
  }
}
