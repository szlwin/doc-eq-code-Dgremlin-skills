{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DEC View YAML",
  "type": "object",
  "$defs": {
    "viewPropertyObject": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "string"
        },
        "refProperty": {
          "type": "string"
        },
        "relation": {
          "enum": [
            "one-to-one",
            "one-to-many"
          ]
        },
        "data": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "relKey": {
          "type": "string"
        },
        "relValue": {
          "type": "string"
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/$defs/viewPropertyObject"
              }
            ]
          }
        },
        "desc": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "kind": {
      "const": "view"
    },
    "version": {
      "type": "string"
    },
    "views": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "system": {
            "type": "string",
            "minLength": 1
          },
          "targetMain": {
            "type": "string"
          },
          "class": {
            "type": "string"
          },
          "className": {
            "type": "string"
          },
          "properties": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "$ref": "#/$defs/viewPropertyObject"
                }
              ]
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "name",
          "system",
          "targetMain",
          "properties"
        ]
      },
      "minItems": 1
    }
  },
  "required": [
    "views"
  ],
  "additionalProperties": false
}
