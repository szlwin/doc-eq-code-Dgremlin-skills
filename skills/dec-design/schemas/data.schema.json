{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DEC Data YAML",
  "type": "object",
  "properties": {
    "kind": {
      "const": "data"
    },
    "version": {
      "type": "string"
    },
    "datas": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "class": {
            "type": "string"
          },
          "className": {
            "type": "string"
          },
          "desc": {
            "type": "string"
          },
          "properties": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "minLength": 1
                    },
                    "desc": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "type"
                  ]
                }
              ]
            }
          },
          "tables": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "dataSource": {
                  "type": "string"
                },
                "key": {
                  "type": "string"
                },
                "keyType": {
                  "enum": [
                    "increment",
                    "set"
                  ]
                },
                "columns": {
                  "type": "object",
                  "minProperties": 1,
                  "additionalProperties": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "object",
                        "properties": {
                          "ref": {
                            "type": "string"
                          },
                          "refProperty": {
                            "type": "string"
                          },
                          "type": {
                            "type": "string"
                          },
                          "relEnum": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "additionalProperties": false
                      }
                    ]
                  }
                }
              },
              "additionalProperties": false,
              "required": [
                "name",
                "dataSource",
                "key",
                "keyType",
                "columns"
              ]
            }
          },
          "system": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "name",
          "system",
          "properties"
        ]
      },
      "minItems": 1
    }
  },
  "required": [
    "datas"
  ],
  "additionalProperties": false
}
