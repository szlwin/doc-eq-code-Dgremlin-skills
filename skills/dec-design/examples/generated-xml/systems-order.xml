<?xml version="1.0" encoding="UTF-8"?>
<systems>
  <system name="user">
    <data-info>
      <data-ref name="user"/>
    </data-info>
    <view-info>
      <view-ref name="UserInfo"/>
    </view-info>
    <rule-file-info>
      <rule-file path="classpath:dec/generated/rule/rule-user.xml"/>
    </rule-file-info>
    <information-info>
      <information name="activated" view-ref="UserInfo" rule-ref="isActivated"/>
      <information name="certified" view-ref="UserInfo" rule-ref="isCertified"/>
      <information name="effective" expression="user.activated&#10;and&#10;user.certified&#10;"/>
    </information-info>
  </system>
  <system name="order">
    <data-info>
      <data-ref name="order"/>
      <data-ref name="orderDetail"/>
    </data-info>
    <view-info>
      <view-ref name="OrderInfo"/>
    </view-info>
    <rule-file-info>
      <rule-file path="classpath:dec/generated/rule/rule-order.xml"/>
    </rule-file-info>
    <information-info>
      <information name="ordered" view-ref="OrderInfo" rule-data="status = 1&#10;and&#10;every(orderDetailList, status = 1)&#10;">
        <change-data><![CDATA[status : 1;
every(orderDetailList, status : 1);]]></change-data>
      </information>
      <information name="waitPay" view-ref="OrderInfo" rule-ref="isWaitPay"/>
      <information name="payable" expression="order.ordered&#10;or&#10;order.waitPay&#10;"/>
      <information name="paying" view-ref="OrderInfo" rule-data="status = 2&#10;and&#10;every(orderDetailList, status = 2)&#10;">
        <change-data><![CDATA[status : 2;
every(orderDetailList, status : 2);]]></change-data>
      </information>
      <information name="paySuccessStatus" view-ref="OrderInfo" rule-data="status = 3&#10;and&#10;every(orderDetailList, status = 3)&#10;">
        <change-data><![CDATA[status : 3;
every(orderDetailList, status : 3);]]></change-data>
      </information>
      <information name="payErrorStatus" view-ref="OrderInfo" rule-data="status = 4&#10;and&#10;every(orderDetailList, status = 4)&#10;">
        <change-data><![CDATA[status : 4;
every(orderDetailList, status : 4);]]></change-data>
      </information>
    </information-info>
    <model-access-info>
      <model-access model-ref="OrderInfo">
        <read path="*">
          <ref view="OrderInfo" property="order"/>
        </read>
        <write path="status">
          <ref view="OrderInfo" property="order"/>
        </write>
        <write path="orderDetailList">
          <ref view="OrderInfo" property="order"/>
        </write>
      </model-access>
    </model-access-info>
  </system>
  <system name="payment">
    <data-info>
      <data-ref name="pay"/>
      <data-ref name="payDetail"/>
    </data-info>
    <view-info>
      <view-ref name="OrderInfo"/>
    </view-info>
    <rule-file-info>
      <rule-file path="classpath:dec/generated/rule/rule-payment.xml"/>
    </rule-file-info>
    <information-info>
      <information name="paymentInfo" view-ref="OrderInfo" rule-ref="hasPaymentInfo"/>
      <information name="hasResult" view-ref="OrderInfo" rule-ref="hasPayResult"/>
      <information name="success" view-ref="OrderInfo" rule-ref="isPaySuccess"/>
      <information name="error" view-ref="OrderInfo" rule-ref="isPayError"/>
      <information name="completed" expression="payment.success&#10;or&#10;payment.error&#10;"/>
    </information-info>
    <model-access-info>
      <model-access model-ref="OrderInfo">
        <read path="*">
          <ref view="OrderInfo" property="order"/>
        </read>
        <write path="payInfo">
          <ref view="OrderInfo" property="order"/>
        </write>
      </model-access>
    </model-access-info>
  </system>
  <system name="common">
    <information-info>
      <information name="paySuccess" expression="payment.success&#10;and&#10;order.paySuccessStatus&#10;"/>
      <information name="payError" expression="payment.error&#10;and&#10;order.payErrorStatus&#10;"/>
    </information-info>
  </system>
</systems>
