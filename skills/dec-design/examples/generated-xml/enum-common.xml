<?xml version="1.0" encoding="UTF-8"?>
<enum-config>
  <enum name="OrderStatus" desc="订单状态">
    <enum-value value="1" name="WAIT_PAY" desc="待支付"/>
    <enum-value value="2" name="PAYING" desc="支付中"/>
    <enum-value value="3" name="PAY_SUCCESS" desc="支付成功"/>
    <enum-value value="4" name="PAY_ERROR" desc="支付失败"/>
  </enum>
  <enum name="OrderType" desc="订单类型">
    <enum-value value="1" name="NORMAL" desc="普通订单"/>
    <enum-value value="2" name="PREORDER" desc="预售订单"/>
  </enum>
  <enum name="PaymentStatus" desc="支付状态">
    <enum-value value="0" name="INIT" desc="初始化"/>
    <enum-value value="1" name="PROCESSING" desc="处理中"/>
  </enum>
  <enum name="PayResultCode" desc="支付结果">
    <enum-value value="SUCCESS" name="SUCCESS" desc="成功"/>
    <enum-value value="ERROR" name="ERROR" desc="失败"/>
  </enum>
</enum-config>
